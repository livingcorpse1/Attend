# ------------------------------------------------------------------------------
# Configuration for VeriQra.
#
# Copy this file to .env and fill in the values. The application reads it on start.
#
# NEVER commit the filled in .env file. It is listed in .gitignore.
# ------------------------------------------------------------------------------

# --- Database (Supabase) ------------------------------------------------------
# The connection string from the Supabase project settings, Data > Database.
# Use the transaction pooler (port 6543) when the direct host is not reachable, for
# example on an IPv6 only network. The direct host looks like this:
#   jdbc:postgresql://db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
#
# IMPORTANT: keep the credentials OUT of the URL. A password that contains an '@'
# makes the JDBC parser split the URL in the wrong place, and the driver then tries
# to resolve the whole string as a host name. Put the user and the password in their
# own fields below and only the host in the URL.
DATABASE_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_USER=postgres.PROJECT_REF
DATABASE_PASSWORD=your-database-password
DATABASE_DRIVER=org.postgresql.Driver
DATABASE_POOL_SIZE=5
# Milliseconds. The keepalive has to be at least 30000, otherwise the pool ignores it.
# Without it the pool hands out connections the server has already closed.
DATABASE_KEEPALIVE_MS=30000
DATABASE_MAX_LIFETIME_MS=300000

# --- Object storage -----------------------------------------------------------
# Supabase Storage holds the enrolment photographs. Use 'local' for a single node
# deployment that does not want the dependency.
STORAGE_PROVIDER=supabase
# The project URL and the secret key from the Supabase project settings, Data > API.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
SUPABASE_STORAGE_BUCKET=veriqra-biometrics
LOCAL_STORAGE_DIR=./data/storage

# --- Security -----------------------------------------------------------------
# At least 64 random characters. Rotating it invalidates every projected QR code.
QR_SIGNING_SECRET=replace-with-at-least-64-random-characters
# The password of the first administrator account. When it is empty the application
# generates one and writes it to the log.
BOOTSTRAP_ADMIN_PASSWORD=
# Set to true when the application is served over HTTPS.
SESSION_COOKIE_SECURE=true
SESSION_TIMEOUT_MINUTES=120

# --- Institution --------------------------------------------------------------
# The name and the location of the college are NOT set here. They are institution
# settings and an administrator sets them from Administration > Settings.
INSTITUTION_TIMEZONE=Asia/Kolkata
LOW_ATTENDANCE_THRESHOLD=75
# The hours of the day in which lectures may be scheduled.
TEACHING_DAY_START=06:00
TEACHING_DAY_END=22:00
# The demonstration accounts. Switch them off for a real deployment.
DEMO_DATA_ENABLED=true

# --- Attendance ---------------------------------------------------------------
QR_TTL_SECONDS=8
QR_REFRESH_SECONDS=1
QR_CLOCK_SKEW_SECONDS=5
SESSION_DURATION_MINUTES=180
VERIFICATION_TICKET_TTL=120
SUBMISSION_INTERVAL_SECONDS=3
MAX_LOGIN_FAILURES=8
LOGIN_FAILURE_WINDOW_MINUTES=15

# --- Biometric pipeline -------------------------------------------------------
# The directory that holds the ONNX models.
VERIQRA_MODELS_DIR=./models
BIOMETRIC_DETECTION_THRESHOLD=0.80
BIOMETRIC_MATCH_THRESHOLD=0.55
BIOMETRIC_LIVENESS_YAW_DELTA=0.16
BIOMETRIC_FRAME_CONSISTENCY=0.50
BIOMETRIC_REQUIRED_FRAMES=5
BIOMETRIC_MIN_FACE_RATIO=0.12
BIOMETRIC_MIN_SHARPNESS=40
BIOMETRIC_MIN_BRIGHTNESS=35
BIOMETRIC_MAX_BRIGHTNESS=225
BIOMETRIC_CHALLENGE_TTL=120
BIOMETRIC_MODEL_VERSION=yunet-2023mar+sface-2021dec

# --- Uploads ------------------------------------------------------------------
MAX_IMAGE_BYTES=3145728
MAX_REQUEST_BYTES=25165824
UPLOAD_MAX_FILE_SIZE=4MB
UPLOAD_MAX_REQUEST_SIZE=24MB

# --- Runtime ------------------------------------------------------------------
PORT=8080
SPRING_PROFILES_ACTIVE=default
